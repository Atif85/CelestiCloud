<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CelestiCloud.GUI.ViewModels"
             x:Class="CelestiCloud.GUI.Views.JobsView"
             x:DataType="vm:JobsViewModel">

    <Grid>
        <!-- LAYER 0: MAIN JOBS LIST SCREEN -->
        <Border Background="{DynamicResource AppBackgroundBrush}" Padding="24">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <TextBlock Grid.Row="0" Text="Configured Jobs" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                
                <!-- Jobs Cards List -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:JobUiModel">
                
                                <Button Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).OpenJobDetailsCommand}" 
                                        CommandParameter="{Binding Config}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="{DynamicResource SidebarBackgroundBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16,18" Margin="0,0,0,10" Cursor="Hand">
                    
                                    <Grid ColumnDefinitions="*, Auto, Auto" Background="Transparent">
                        
                                        <!-- Col 0: Text Content -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Config.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Config.JobType}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Config.RemoteRootPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 1: Dynamic Theme-Aware Status Badges -->
                        
                                        <!-- Running Badge -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource SuccessBackgroundBrush}" 
                                                BorderBrush="{DynamicResource SuccessBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="10,6" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,24,0"
                                                IsVisible="{Binding IsRunning}">
                                            <TextBlock Text="● Running" Foreground="{DynamicResource SuccessForegroundBrush}" FontSize="12" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Stopped Badge -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource ContentBackgroundBrush}" 
                                                BorderBrush="{DynamicResource DividerBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="8,4" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,24,0"
                                                IsVisible="{Binding !IsRunning}">
                                            <TextBlock Text="○ Idle" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Col 2: Arrow -->
                                        <TextBlock Grid.Column="2" Text="➔" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Add New Job" Command="{Binding OpenAddJobCommand}" Padding="18,10" FontSize="16" FontWeight="SemiBold" CornerRadius="8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LAYER 1: MODAL DIMMER OVERLAY -->
        <Border Background="#A0000000" IsVisible="{Binding IsDimmerVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <!-- LAYER 1A: VIEW DETAILS MODAL -->
                <Border Width="550" MaxHeight="650"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="12" BoxShadow="0 8 32 0 #40000000"
                        IsVisible="{Binding IsViewModalOpen}">
                    
                    <Grid RowDefinitions="Auto, *, Auto">
                        
                        <!-- Header with Status Badge -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,24,24,16">
                            <TextBlock Grid.Column="0" Text="{Binding SelectedJobDetails.Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            
                            <!-- Dynamic Status Badges -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SuccessBackgroundBrush}" 
                                    BorderBrush="{DynamicResource SuccessBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="8,4" 
                                    IsVisible="{Binding IsSelectedJobRunning}">
                                <TextBlock Text="● Running" Foreground="{DynamicResource SuccessForegroundBrush}" FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <!-- Stopped Detail Badge (Theme-aware) -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ContentBackgroundBrush}" 
                                    BorderBrush="{DynamicResource DividerBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="8,4" 
                                    IsVisible="{Binding !IsSelectedJobRunning}">
                                <TextBlock Text="○ Stopped" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Scrollable Info -->
                        <ScrollViewer Grid.Row="1" Margin="24,0,24,16">
                            <StackPanel Spacing="16">
                                <Separator Background="{DynamicResource DividerBrush}"/>
                                
                                <Grid ColumnDefinitions="150, *">
                                    <TextBlock Grid.Column="0" Text="Type:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedJobDetails.JobType}"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="150, *">
                                    <TextBlock Grid.Column="0" Text="Target Account ID:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedJobDetails.TargetAccountId}"/>
                                </Grid>

                                <Grid ColumnDefinitions="150, *">
                                    <TextBlock Grid.Column="0" Text="Cloud Target:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedJobDetails.RemoteRootPath}"/>
                                </Grid>

                                <Grid ColumnDefinitions="150, *">
                                    <TextBlock Grid.Column="0" Text="Auto-Start:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedJobDetails.AutoStart}"/>
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}"/>

                                <TextBlock Text="Monitored Local Folders:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding SelectedJobDetails.LocalPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="10,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Ignore Patterns:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                                <ItemsControl ItemsSource="{Binding SelectedJobDetails.IgnorePatterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="10,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,16">
                            <Grid ColumnDefinitions="*, Auto">
                                
                                <!-- Play/Stop Action -->
                                <Button Grid.Column="0" HorizontalAlignment="Left"
                                        Command="{Binding ToggleSelectedJobStateCommand}" 
                                        IsEnabled="{Binding !IsTogglingState}"
                                        Padding="16,8" CornerRadius="6" Cursor="Hand"> 
                                    <Panel>
        
                                        <!-- 1. START STATE -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsStartButtonVisible}">
                                            <TextBlock Text="▶" Foreground="#4CAF50"/>
                                            <TextBlock Text="Start Job" FontWeight="Bold"/>
                                        </StackPanel>
        
                                        <!-- 2. STOP STATE -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsStopButtonVisible}">
                                            <TextBlock Text="⏹" Foreground="#FF5252"/>
                                            <TextBlock Text="Stop Job" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- 3. PROCESSING STATE (Prevents confusion while waiting for the engine) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsProcessingButtonVisible}">
                                            <TextBlock Text="⏳" Foreground="#FFC107"/>
                                            <TextBlock Text="Processing..." FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
        
                                    </Panel>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <Button Content="Edit" Command="{Binding OpenEditJobCommand}" CornerRadius="6" Padding="16,8" Cursor="Hand"/>
                                    <Button Content="Close" Command="{Binding CloseJobDetailsCommand}" CornerRadius="6" Padding="16,8" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- LAYER 1B: JOB EDITOR MODAL -->
                <Border Width="550" MaxHeight="650"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="12" BoxShadow="0 8 32 0 #40000000"
                        IsVisible="{Binding IsEditModalOpen}">
                    
                    <Grid RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Margin="24,24,24,16">
                            <!-- Shows when creating a new job -->
                            <TextBlock Text="Create New Job" 
                                       IsVisible="{Binding IsCreatingNew}"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
    
                            <!-- Shows when editing an existing job -->
                            <TextBlock Text="Edit Job Configuration" 
                                       IsVisible="{Binding !IsCreatingNew}"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
    
                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- Same Scrollable Form Content As Before... -->
                        <ScrollViewer Grid.Row="1" Margin="24,0,24,0" Padding="0,0,16,0">
                            <StackPanel Spacing="16" DataContext="{Binding EditingJob}">
                                
                                <Grid ColumnDefinitions="*, 150">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Job Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Name}" PlaceholderText="e.g. Work Documents"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Job Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox SelectedIndex="{Binding JobType}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem>Sync</ComboBoxItem>
                                            <ComboBoxItem>Backup</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="Target Account" FontWeight="SemiBold" Margin="0,0,0,4"/>
    
                                    <!-- CHANGED: Replaced SelectedValue with SelectedItem -->
                                    <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).AvailableAccounts}"
                                              SelectedItem="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).EditingTargetAccount}" 
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 150">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Remote Cloud Path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RemoteRootPath}" PlaceholderText="e.g. /CelestiCloud/Docs"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Max Concurrent" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <NumericUpDown Value="{Binding MaxConcurrentTransfers, TargetNullValue=1, FallbackValue=1}"
                                                       ParsingNumberStyle="Integer"
                                                       Minimum="1" Maximum="20"/>
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch IsChecked="{Binding AutoStart}" Content="Auto-start on launch" Margin="0,5"/>
                                <Separator Background="{DynamicResource DividerBrush}"/>

                                <!-- Local Paths -->
                                <StackPanel>
                                    <TextBlock Text="Local Folder Paths" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).EditingLocalPaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#FF6B6B" Cursor="Hand"
                                                            Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).RemoveLocalPathCommand}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                                        <!-- Path Input Textbox -->
                                        <TextBox Grid.Column="0" 
                                                    PlaceholderText="Add full path (e.g. C:\Docs)" 
                                                    Text="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).NewLocalPathInput}" 
                                                    Margin="0,0,8,0"/>
    
                                        <!-- Browse Button -->
                                        <Button Grid.Column="1" 
                                                Content="Browse..." 
                                                Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).BrowseLocalPathCommand}" 
                                                Margin="0,0,8,0" 
                                                CornerRadius="6"
                                                Cursor="Hand"/>
    
                                        <!-- Add Button -->
                                        <Button Grid.Column="2" 
                                                Content="Add" 
                                                Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).AddLocalPathCommand}" 
                                                CornerRadius="6"
                                                Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>

                                <Separator Background="{DynamicResource DividerBrush}"/>

                                <!-- Ignore Patterns -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Ignore Patterns (.gitignore syntax)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).EditingIgnorePatterns}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#FF6B6B" Cursor="Hand"
                                                            Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).RemoveIgnorePatternCommand}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <TextBox Grid.Column="0" PlaceholderText="Add pattern (e.g. *.tmp)" Text="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).NewIgnorePatternInput}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Add" Command="{Binding $parent[UserControl].((vm:JobsViewModel)DataContext).AddIgnorePatternCommand}" CornerRadius="6"/>
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="24,16">
                            <Grid ColumnDefinitions="Auto, *">
                                
                                <Button Grid.Column="0" Content="Delete Job" IsVisible="{Binding !IsCreatingNew}"
                                        Command="{Binding DeleteJobCommand}" Classes="danger" Cursor="Hand"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                    <Button Content="Cancel" Command="{Binding CloseEditModalCommand}" Padding="16,8" Cursor="Hand" CornerRadius="6"/>
                                    <Button Content="Create Job" IsVisible="{Binding IsCreatingNew}" Command="{Binding SaveJobCommand}" Classes="success" Padding="16,8" Cursor="Hand" FontWeight="Bold"/>
                                    <Button Content="Save Changes" IsVisible="{Binding !IsCreatingNew}" Command="{Binding SaveJobCommand}" Classes="success" Padding="16,8" Cursor="Hand" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>