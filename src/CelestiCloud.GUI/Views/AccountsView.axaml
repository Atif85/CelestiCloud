<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CelestiCloud.GUI.ViewModels"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="500"

             xmlns:models="using:CelestiCloud.Core.Models"
             x:Class="CelestiCloud.GUI.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
    
    <Grid>
        <!-- LAYER 0: MAIN ACCOUNTS LIST SCREEN -->
        <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="24">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- Screen Title -->
                <TextBlock Grid.Row="0" 
                           Text="Linked Accounts" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,20"/>
                
                <!-- Accounts Cards List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="16,18"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.Styles>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AccountConfig">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" 
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Provider}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" 
                                           Text="➔" 
                                           FontSize="16" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Footer Action Panel -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,16,0,0">
                    <Button Content="Add Account" 
                            Command="{Binding OpenAddAccountCommand}"
                            Padding="18,10"
                            FontSize="16"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LAYER 1: MODAL DIMMER OVERLAY BACKGROUND -->
        <Border Background="#A0000000" 
                IsVisible="{Binding IsDimmerVisible}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid>
                <!-- CARD A: ADD ACCOUNT POPUP -->
                <Border Width="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        BoxShadow="0 8 32 0 #40000000"
                        IsVisible="{Binding IsAddAccountOpen}">
                    
                    <StackPanel Spacing="16">
                        <TextBlock Text="Link New Account" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        
                        <Separator Background="{DynamicResource DividerBrush}"/>

                        <StackPanel IsVisible="{Binding !IsAuthenticating}" Spacing="12">
                            <TextBlock Text="Choose a cloud storage provider to link:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            
                            <!-- Interactive Provider Button -->
                            <Button HorizontalAlignment="Stretch" 
                                    Padding="16,12" 
                                    Command="{Binding LinkAccountCommand}" 
                                    CommandParameter="googledrive"
                                    Background="{DynamicResource ContentBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="📁" FontSize="20" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Drive" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Sync and back up files to your Google account" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Browser Loading Spinner State -->
                        <StackPanel IsVisible="{Binding IsAuthenticating}" Spacing="16" HorizontalAlignment="Center" Margin="0,10">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Please log in using your web browser..." FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                            <Button Content="Cancel" Command="{Binding CloseAddAccountCommand}" Padding="16,8" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD B: ACCOUNT DETAILS POPUP -->
                <Border Width="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        BoxShadow="0 8 32 0 #40000000"
                        IsVisible="{Binding IsDetailsOpen}">
                    
                    <StackPanel Spacing="16">
                        <TextBlock Text="Account Details" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        
                        <Separator Background="{DynamicResource DividerBrush}"/>

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,4" VerticalAlignment="Center">
                            <!-- Email -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAccountDetails.DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <!-- Provider -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccountDetails.Provider}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- ID -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Internal ID:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccountDetails.Id}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- Connected At -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Connected At:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,10"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAccountDetails.ConnectedAt}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                        </Grid>

                        <Separator Background="{DynamicResource DividerBrush}"/>

                        <!-- Modal Actions Footer -->
                        <Grid ColumnDefinitions="*, Auto">
                            <!-- Left-aligned Red Remove Button -->
                            <Button Grid.Column="0" 
                                    Content="Disconnect" 
                                    Command="{Binding RemoveAccountCommand}" 
                                    Background="#2E0C0C" 
                                    Foreground="#FF6B6B"
                                    BorderBrush="#5E1414"
                                    BorderThickness="1"
                                    Padding="14,8" 
                                    Cursor="Hand"/>
                            
                            <!-- Right-aligned Close Button -->
                            <Button Grid.Column="1" 
                                    Content="Close" 
                                    Command="{Binding CloseDetailsCommand}" 
                                    Padding="16,8" 
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>