<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CelestiCloud.GUI.Views.DashboardView">
    
    <!-- Changed Grid to Border to support the Padding property -->
    <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="20">
        <StackPanel Spacing="10">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="A high-level view of your active tasks and bandwidth speeds will go here." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Border>
    
</UserControl>