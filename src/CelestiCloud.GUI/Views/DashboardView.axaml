<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CelestiCloud.GUI.ViewModels"
             xmlns:jobs="using:CelestiCloud.Core.Jobs"
             x:Class="CelestiCloud.GUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <Grid>
        <Border Background="{DynamicResource AppBackgroundBrush}" Padding="24">
            <Grid RowDefinitions="Auto, *">
                
                <!-- HEADER BAR -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,0,0,20">
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- Live Stats Display -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel>
                            <TextBlock Text="Current Speed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentSpeedText}" FontSize="16" FontWeight="Bold" Foreground="MediumSeaGreen" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Total Sent" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalUploadedText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="View Logs" Command="{Binding OpenLogViewerCommand}" CornerRadius="6" Padding="16,8" Cursor="Hand"/>
                        <Button Content="Stop All" Command="{Binding StopAllJobsCommand}" Classes="danger" Padding="16,8" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- ACTIVE JOBS LIST -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding ActiveJobsList}">
                        
                        <!-- Empty State -->
                        <ItemsControl.Styles>
                            <Style Selector="ItemsControl:empty">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <TextBlock Text="No jobs are currently running." 
                                                    Foreground="{DynamicResource TextSecondaryBrush}"    
                                                    HorizontalAlignment="Center" 
                                                    Margin="0,50,0,0"/>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ItemsControl.Styles>

                        <!-- Active Job Card -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningJobViewModel">
                                <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                        BorderBrush="{DynamicResource DividerBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="20" 
                                        Margin="0,0,0,16">
                                    <StackPanel Spacing="12">
                        
                                        <!-- Job Title & Global Progress -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding JobName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding FilesProcessed}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="/" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FilesFound}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="files processed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                        
                                        <Separator Background="{DynamicResource DividerBrush}"/>

                                        <!-- Currently Uploading Files (Targeting UI-Friendly ActiveTransfers) -->
                                        <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                                            <ItemsControl.Styles>
                                                <Style Selector="ItemsControl:empty">
                                                    <Setter Property="Template">
                                                        <ControlTemplate>
                                                            <TextBlock Text="No uploads are currently running." 
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,30"/>
                                                        </ControlTemplate>
                                                    </Setter>
                                                </Style>
                                            </ItemsControl.Styles>

                                            <ItemsControl.ItemTemplate>
                                                <!-- Targeting TransferProgressViewModel -->
                                                <DataTemplate x:DataType="vm:TransferProgressViewModel">
                                                    <Grid ColumnDefinitions="*, Auto, 200, 40" Margin="0,5">
                                                        <!-- CLICKABLE HYPERLINK FILE PATH -->
                                                        <Button Grid.Column="0" 
                                                                Command="{Binding OpenContainingFolderCommand}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="Click to show in file explorer"
                                                                Cursor="Hand"
                                                                Margin="0,0,16,0">
            
                                                            <!-- Hyperlink Hover Styles -->
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                </Style>
                                                                <Style Selector="Button:pointerover TextBlock">
                                                                    <!-- Underline and subtle highlight on hover -->
                                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                                    <Setter Property="Foreground" Value="#00BFFF" /> 
                                                                </Style>
                                                            </Button.Styles>

                                                            <TextBlock Text="{Binding FileName}" 
                                                                       VerticalAlignment="Center" 
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                       TextTrimming="CharacterEllipsis" 
                                                                       Margin="0,0,10,0"/>
                                                        </Button>

                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding FileSizeText}" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,0,16,0"/>

                                                        <!-- PROGRESS BAR -->
                                                        <ProgressBar Grid.Column="2" 
                                                                     Minimum="0" 
                                                                     Maximum="1" 
                                                                     Value="{Binding Progress}" 
                                                                     Height="8" 
                                                                     CornerRadius="4" 
                                                                     VerticalAlignment="Center"
                                                                     Background="{DynamicResource ProgressBarTrackBrush}"
                                                                     Foreground="{DynamicResource ProgressBarIndicatorBrush}"
                                                                     Margin="0,0,16,0"/>

        
                                                        <!-- PERCENTAGE TEXT -->
                                                        <TextBlock Grid.Column="3" 
                                                                   Text="{Binding Progress, StringFormat={}{0:P0}}" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- LOG VIEWER MODAL OVERLAY -->
        <Border Background="#A0000000" IsVisible="{Binding IsLogViewerOpen}">
            <Border Width="850" Height="600" 
                    Background="{DynamicResource ContentBackgroundBrush}" 
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" 
                    CornerRadius="12" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
        
                <Grid RowDefinitions="Auto, *, Auto">
            
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0" Text="Application Logs" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" 
                                Content="📁 Open Logs Folder" 
                                Command="{Binding OpenLogsFolderCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius ="6"
                                Cursor="Hand"/>
                    </Grid>
            
                    <!-- Terminal-Style Log Output -->
                    <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                        <!-- A ScrollViewer wraps an ItemsControl so we can easily colorize individual parts of the text -->
                        <ScrollViewer Padding="12">
                            <ItemsControl ItemsSource="{Binding LiveLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,2">
                                    
                                            <!-- Timestamp (Gray) -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FormattedTime, StringFormat='[{0}] '}" 
                                                       Foreground="#888888" 
                                                       FontFamily="Consolas, Monospace" 
                                                       FontSize="13"/>
                                    
                                            <!-- Log Level (Colored dynamically based on our C# ColorHex property) -->
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Level, StringFormat='[{0}] '}" 
                                                       Foreground="{Binding ColorHex}" 
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, Monospace" 
                                                       FontSize="13"
                                                       Width="70"/>
                                    
                                            <!-- Message Text (Light Gray) -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding Text}" 
                                                       Foreground="#CCCCCC" 
                                                       FontFamily="Consolas, Monospace" 
                                                       FontSize="13" 
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
            
                    <Button Grid.Row="2" Content="Close Viewer" Command="{Binding CloseLogViewerCommand}" HorizontalAlignment="Right" CornerRadius="6" Margin="0,15,0,0" Padding="20,8"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>