<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CelestiCloud.GUI.ViewModels"
             x:Class="CelestiCloud.GUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Border Background="{DynamicResource AppBackgroundBrush}" Padding="24">
        <StackPanel Spacing="30">
            
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- APPEARANCE -->
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>
                
                <Grid ColumnDefinitions="350, *">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="App Theme" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Select your preferred color scheme." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1" 
                              Width="200"
                              ItemsSource="{Binding AvailableThemes}" 
                              SelectedItem="{Binding SelectedTheme}">
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- SYSTEM / BEHAVIOR -->
            <StackPanel Spacing="12">
                <TextBlock Text="System" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>

                <!-- Start on Startup -->
                <Grid ColumnDefinitions="350, *" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start on Startup" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Launch CelestiCloud on system startup." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartOnStartup}" OffContent="Off" OnContent="On" HorizontalAlignment="Left"/>
                </Grid>

                <!-- Minimize to Tray -->
                <Grid ColumnDefinitions="350, *">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Minimize to Tray" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Minimize to the system tray instead of closing." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}" OffContent="Off" OnContent="On" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>

            <!-- BANDWIDTH LIMITS -->
            <StackPanel Spacing="12">
                <TextBlock Text="Bandwidth Limits" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>
                
                <!-- Upload Limit -->
                <Grid ColumnDefinitions="350, *">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Max Upload Speed" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Type e.g. '1.5mb', '500kb', '1.2' or '500'." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- A Textbox replaces the NumericUpDown control -->
                    <TextBox Grid.Column="1" 
                             Width="200"
                             Text="{Binding UploadLimitInput, UpdateSourceTrigger=LostFocus}" 
                             PlaceholderText="e.g. 1.2mb or 500kb"
                             HorizontalAlignment="Left"
                             LosingFocus="TextBox_LostFocus"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>