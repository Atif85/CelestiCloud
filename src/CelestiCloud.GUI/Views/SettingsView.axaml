<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CelestiCloud.GUI.Views.SettingsView">
    
    <!-- Changed Grid to Border to support the Padding property -->
    <Border Background="{DynamicResource ContentBackgroundBrush}" Padding="20">
        <StackPanel Spacing="10">
            <TextBlock Text="Global Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Adjust your global upload/download speeds, themes, and cache settings here." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Border>
    
</UserControl>